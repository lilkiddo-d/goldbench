# ─── Goldbench frontend configuration ───────────────────────────────────────────
# All variables are NEXT_PUBLIC_* and are inlined at BUILD time — rebuild after changing them.

# JSON-RPC endpoint for Robinhood Chain (chainId 4663).
# Default: the public, rate-limited endpoint. For a local anvil fork use http://127.0.0.1:8555
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Which deployment file to load from src/config/deployments.<NEXT_PUBLIC_DEPLOYMENT>.json
# Known values: 4663 (mainnet), 4663-fork (local fork). Default: 4663
NEXT_PUBLIC_DEPLOYMENT=4663

# WalletConnect Cloud project id. Empty = injected browser wallets only (MetaMask, Rabby, ...).
NEXT_PUBLIC_WC_PROJECT_ID=

# $GBEN project token address. Empty = all token features hidden (no /stake page, rebates, governance).
NEXT_PUBLIC_PROJECT_TOKEN=

# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes (e.g. "US,CU,IR,KP,SY").
# Uses Vercel's x-vercel-ip-country header. Empty = no geoblocking.
# Suggested: Stock Tokens may not be offered to US persons and are restricted in CA, GB, CH (and others,
# see http://docs.robinhood.com/rhj). /risk and /blocked are never blocked.
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=US,CA,GB,CH

# Optional: max number of blocks scanned per "load" for rebalance-history events
# (scanned backwards in 50,000-block pages). Default 2,000,000 (~5.8 days at ~4 blocks/s).
NEXT_PUBLIC_LOG_SCAN_BLOCKS=2000000
